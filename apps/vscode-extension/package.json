{
  "name": "omni-schematics",
  "displayName": "Omni Schematics",
  "description": "Schematic capture, component authoring and circuit/system simulation inside VS Code. Runs the general-simulator engine today, and is built to run others.",
  "version": "0.8.0",
  "private": false,
  "publisher": "gensim",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Visualization", "Data Science", "Other"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omniSchematics",
          "title": "Omni Schematics",
          "icon": "media/gsim.svg"
        }
      ]
    },
    "views": {
      "omniSchematics": [
        {
          "id": "omniSchematics.library",
          "name": "Block Library",
          "type": "webview",
          "contextualTitle": "Omni Schematics"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "omniSchematics.schematic",
        "displayName": "Schematic (Omni Schematics)",
        "selector": [
          {
            "filenamePattern": "*.gsim_sch"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "omniSchematics.simResult",
        "displayName": "Simulation Result (Omni Schematics)",
        "selector": [
          {
            "filenamePattern": "*.gsim_sim_result"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "omniSchematics.showWaveforms",
        "title": "Show Waveforms",
        "category": "Omni Schematics",
        "icon": "$(graph-line)"
      },
      {
        "command": "omniSchematics.restartKernel",
        "title": "Restart Simulation Kernel",
        "category": "Omni Schematics",
        "icon": "$(debug-restart)"
      },
      {
        "command": "omniSchematics.showKernelLog",
        "title": "Show Kernel Log",
        "category": "Omni Schematics"
      },
      {
        "command": "omniSchematics.newSchematic",
        "title": "New Schematic",
        "category": "Omni Schematics"
      },
      {
        "command": "omniSchematics.openExample",
        "title": "Open Example Schematic…",
        "category": "Omni Schematics"
      },
      {
        "command": "omniSchematics.openSchematic",
        "title": "Open Schematic…",
        "category": "Omni Schematics"
      },
      {
        "command": "omniSchematics.forwardChord",
        "title": "Forward a keyboard shortcut to the schematic",
        "enablement": "false"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "omniSchematics.showWaveforms",
          "when": "activeCustomEditorId == omniSchematics.schematic",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "omniSchematics.showWaveforms"
        },
        {
          "command": "omniSchematics.restartKernel"
        },
        {
          "command": "omniSchematics.showKernelLog"
        },
        {
          "command": "omniSchematics.newSchematic"
        }
      ]
    },
    "configuration": {
      "title": "Omni Schematics",
      "properties": {
        "omniSchematics.kernelPython": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Python environment that runs the simulation kernel — either a virtualenv directory or a Python executable inside one.\n\n**This is required.** Nothing simulates until it is set: the editor starts the kernel from the environment you name and never builds, syncs or discovers one.\n\nThat environment needs the `kernel_sidecar`, `simulator`, `kernel-core`, `gsim-model`, `schemas`, `components` and `synthesis` packages and their scientific dependencies (`numpy`, `scipy`, `sympy`, `websockets`, `h5py`), plus a `gsim_py` wheel to compile a schematic and `gsim-tools` for script-authored documents.\n\nTwo ways to get one:\n\n- in a checkout of this repository, `node scripts/make-kernel-venv.mjs`, which builds it and prints the path to paste here;\n- or `pip install` the wheels attached to a release into a virtualenv of your own.\n\nThe editor does not care which; it only runs what is there.",
          "description": "Required. Path to the Python environment (virtualenv directory or interpreter) that runs the simulation kernel. Nothing simulates until this is set. Build one with `node scripts/make-kernel-venv.mjs`, or pip install a release's wheels into a virtualenv."
        },
        "omniSchematics.autoStartKernel": {
          "type": "boolean",
          "default": true,
          "description": "Start the kernel sidecar automatically when the extension activates.",
          "markdownDescription": "Start the simulation kernel automatically when the extension activates."
        },
        "omniSchematics.generalSimulatorPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `general-simulator` binary — the engine that does the numerical work.\n\nThis is handed to the simulation kernel **after** the kernel has started, so it cannot start one by itself: if `#omniSchematics.kernelPython#` is unset, the kernel never starts and nothing here is ever read. Set that one first.\n\nLeave empty to search, in order: this setting, `GENSIM_GENERAL_SIMULATOR_PATH`, then `PATH`, then a sibling `general-simulator` checkout beside the workspace. Build it with `cargo build --release -p general-simulator-cli` and point here at `target/release/general-simulator`.",
          "scope": "machine-overridable"
        },
        "omniSchematics.octaveCliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `octave-cli` binary, for `octfunc` / `octblock` code blocks.\n\nThe engine looks this up on `PATH` only — it has no flag for it — so setting this puts its directory at the front of the `PATH` the simulation process inherits.",
          "scope": "machine-overridable"
        },
        "omniSchematics.pythonPath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra directories to put on `PYTHONPATH` for `pyblock` / `pyfunc` code blocks, so a block can import your own modules.\n\nRelative entries resolve against the workspace folder. This does not change which interpreter runs — the engine embeds the one it was built against.",
          "scope": "machine-overridable"
        },
        "omniSchematics.environment": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Extra environment variables for the simulation kernel and everything it starts.\n\nAn escape hatch for anything without its own setting. Applied after the settings above, so an entry here wins.",
          "scope": "machine-overridable"
        },
        "omniSchematics.overrideVsCodeKeybindings": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "While a schematic is the active editor, let the schematic's keyboard shortcuts override VS Code's. **On by default.**\n\nThe schematic binds 28 chords that VS Code also claims at the workbench level — `Ctrl+R` rotates the selection here and opens VS Code's recent-files list there — and without this VS Code wins every one of them, because a webview only sees a keystroke the workbench did not take first.\n\nTurn this off to give those chords back to VS Code. The schematic then loses them; the rest of its shortcuts keep working. See `docs/keyboard-conflicts.md` for the full list.\n\nThis only ever applies while a schematic tab is focused. A source file, the explorer and the terminal are untouched either way."
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "*.gsim_sch": "json",
        "*.gsim_sym": "json",
        "*.gsim_sim_result": "json"
      }
    },
    "keybindings": [
      {
        "key": "ctrl+-",
        "command": "omniSchematics.forwardChord",
        "when": "activeCustomEditorId == 'omniSchematics.schematic' && config.omniSchematics.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+-"
        }
      },
      {
        "key": "ctrl++",
        "command": "omniSchematics.forwardChord",
        "when": "activeCustomEditorId == 'omniSchematics.schematic' && config.omniSchematics.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl++"
        }
      },
      {
        "key": "ctrl+0",
        "command": "omniSchematics.forwardChord",
        "when": "activeCustomEditorId == 'omniSchematics.schematic' && config.omniSchematics.overrideVsCodeKeybindings",
        "args": {
